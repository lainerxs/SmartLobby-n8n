      "parameters": {
        "jsCode": "// ===== EDIT THIS LIST: dropdown text -> employee name + email =====\nconst directory = {\n  \"Maria Santos - HR (Applicants & Interviews)\": { name: \"Maria Santos\", email: \"maria@example.com\" },\n  \"Juan Cruz - Operations Manager\":             { name: \"Juan Cruz\",    email: \"juan@example.com\" },\n  \"Ana Reyes - Admin (Deliveries)\":             { name: \"Ana Reyes\",    email: \"ana@example.com\" },\n  \"Mark Lim - Facilities (Maintenance & Repairs)\": { name: \"Mark Lim\",  email: \"mark@example.com\" },\n  \"Front Desk (Not sure / Other)\":              { name: \"Front Desk\",   email: \"frontdesk@example.com\" },\n};\n// ==================================================================\nconst f = $input.first().json;\nconst host = directory[f['Person to Visit']] || directory[\"Front Desk (Not sure / Other)\"];\nconst now = $now;\nreturn [{ json: {\n  visitId: 'V-' + now.toFormat('MMdd-HHmmss'),\n  date: now.toFormat('yyyy-MM-dd'),\n  timeIn: now.toFormat('HH:mm'),\n  visitor: f['Full Name'],\n  email: f['Email'],\n  phone: f['Phone'] || '',\n  company: f['Company / From'] || '',\n  visitType: f['Visit Type'],\n  purpose: f['Purpose of Visit'] || f['Remarks'] || '',\n  hostName: host.name,\n  hostEmail: host.email,\n}}];"
      },
