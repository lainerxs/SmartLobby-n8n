                    "option": "Come in now"
                  },
                  {
                    "option": "Wait in lobby"
                  },
                  {
                    "option": "Come back later"
                  },
                  {
                    "option": "Leave it at the front desk"
                  },
                  {
                    "option": "Approach Front Desk Area"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Where / When",
              "placeholder": "e.g. Room 2, 3rd floor  |  15 minutes  |  Tomorrow 10:00 AM"
            },
            {
              "fieldLabel": "Note to visitor",
              "fieldType": "textarea"
            }
          ]
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 10,
              "resumeUnit": "minutes"
            }
          },
          "appendAttribution": false
        }
      },
      "id": "da895876-6d08-44a3-9e85-4dc9e56562db",
      "name": "Ask Employee (waits 10 min)",
