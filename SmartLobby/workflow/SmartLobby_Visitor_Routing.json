    {
      "parameters": {
        "jsCode": "// Turn the decision (from the employee OR the front desk) into a clear message for the visitor\nconst v = $('Employee Directory').first().json;\nconst d = $input.first().json.data || {};\nconst where = (d['Where / When'] || '').trim();\nconst note = (d['Note to visitor'] || '').trim();\nconst first = (v.visitor || '').split(' ')[0];\nlet status, instruction;\nswitch (d.Decision) {\n  case 'Come in now':\n    status = 'Sent in';\n    instruction = `Please proceed to ${where || 'the office of ' + v.hostName}. ${v.hostName} is ready for you.`;\n    break;\n  case 'Wait in lobby':\n    status = 'Waiting in lobby';\n    instruction = `Please have a seat in the lobby. ${v.hostName} will meet you${where ? ' in about ' + where : ' shortly'}.`;\n    break;\n  case 'Come back later':\n    status = 'Rescheduled';\n    instruction = `${v.hostName} is not available right now. Please come back ${where ? 'on ' + where : 'at another time'}. Sorry for the inconvenience.`;\n    break;\n  case 'Leave it at the front desk':\n    status = 'Left at front desk';\n    instruction = `Please leave the item with the front desk. ${v.hostName} will pick it up. Thank you!`;\n    break;\n  case 'Employee Unavailable':      // chosen by the FRONT DESK after calling the employee\n  case 'Could not reach employee':  // (older label, kept for safety)\n    status = 'Employee Unavailable';\n    instruction = `We're sorry, ${v.hostName} is not available right now. ${where ? 'Please come back on ' + where + '.' : 'Our front desk will contact you to set a new schedule.'}`;\n    break;\n  case 'Approach Front Desk Area':  // chosen by the employee\n    status = 'Front desk to assist';\n    instruction = 'Please approach the front desk area and they will assist you.';\n    break;\n  default:                          // safety net: unknown answer -> front desk handles it\n    status = 'Front desk to assist';\n    instruction = 'Please approach the front desk and they will assist you.';\n}\nreturn [{ json: {\n  ...v, status, instruction,\n  fullText: `Hi ${first},\\n\\n${instruction}${note ? '\\n\\nNote: ' + note : ''}\\n\\nThank you for visiting!`,\n  respondedAt: $now.toFormat('HH:mm'),\n}}];"
      },
      "id": "7b495df8-3ff7-476a-8baf-c737e907e804",
      "name": "Build Instructions",
      "type": "n8n-nodes-base.code",
