    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $('Employee Directory').item.json.hostEmail }}",
        "subject": "=Visitor for you: {{ $('Employee Directory').item.json.visitor }} ({{ $('Employee Directory').item.json.visitType }})",
        "message": "=Hi {{ $('Employee Directory').item.json.hostName }},\n\nYou have a visitor at the front desk.\n\n━━━━━━━━━━━━━━━━━━\nVISITOR DETAILS\n━━━━━━━━━━━━━━━━━━\n- Name: {{ $('Employee Directory').item.json.visitor }}\n- From: {{ $('Employee Directory').item.json.company || '—' }}\n- Visit type: {{ $('Employee Directory').item.json.visitType }}\n- Purpose: {{ $('Employee Directory').item.json.purpose || '—' }}\n- Arrived: {{ $('Employee Directory').item.json.timeIn }}\n- Visit ID: {{ $('Employee Directory').item.json.visitId }}\n━━━━━━━━━━━━━━━━━━\n\nPlease click the button below and tell us where they should go.",
        "responseType": "customForm",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Decision",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
